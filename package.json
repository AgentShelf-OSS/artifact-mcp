{
  "name": "artifact-mcp",
  "private": true,
  "type": "module",
  "description": "Self-hostable MCP server for publishing agent-made HTML artifacts to your own domain, with multi-org tenancy",
  "license": "Apache-2.0",
  "author": "Neil Blackman",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "artifacts",
    "self-hosted",
    "multi-tenant",
    "cloudflare-access"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "cf-access:setup": "node scripts/cf-access-setup.mjs",
    "tunnel:start": "node scripts/anthropic-tunnel.mjs start",
    "tunnel:status": "node scripts/anthropic-tunnel.mjs status",
    "tunnel:validate": "node scripts/anthropic-tunnel.mjs validate",
    "tunnel:rollback": "node scripts/anthropic-tunnel.mjs rollback",
    "test": "node --test --test-concurrency=1"
  }
}
