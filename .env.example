# Upload keys: clientId:org:secret (comma-separated). Generate a secret: openssl rand -hex 24
# Uncomment and set a REAL secret. Placeholder values (CHANGE_ME /
# REPLACE_WITH_LONG_RANDOM_SECRET) are ignored at startup, so a copied example never leaves
# a known admin key live on /mcp.
# ARTIFACT_API_KEYS=me:admin:REPLACE_WITH_LONG_RANDOM_SECRET

# Optional MCP OAuth machine identity. Configure all three together. ArtifactShelf validates
# short-lived JWT access tokens as the resource server; token issuance remains with your OAuth
# authorization server. The audience should identify this exact MCP endpoint.
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_AUDIENCE=https://artifacts.example.com/mcp
# MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Asymmetric JWS algorithms only; RS256 is the default.
# MCP_OAUTH_ALLOWED_ALGS=RS256
# Access tokens must include integer iat/exp and cannot exceed this lifetime (default 3600s).
# MCP_OAUTH_MAX_TOKEN_LIFETIME_S=3600
# Temporal claim tolerance (default 30s).
# MCP_OAUTH_CLOCK_TOLERANCE_S=30
# API keys stay enabled during migration. Set to 0 only after OAuth is completely configured.
# MCP_API_KEYS_ENABLED=1

# Encrypt Discord webhook URLs in SQLite with AES-256-GCM. Generate once with:
#   openssl rand -base64 32
# Keep this key with deployment secrets and backups. If unset, webhook URLs still work but are
# stored in plaintext and startup emits a prominent warning. See README.md before rotating it.
# WEBHOOK_ENC_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Migration fallback only for an existing PBI-079 connection. Save a write-only, encrypted
# per-organization credential in Settings instead. Never copy this value into logs or browser UI.
# DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN

# Operator kill switch for explicit per-artifact two-way Discord sync. Defaults off. Enabling it
# requires the GUILDS, GUILD_MESSAGES, and privileged MESSAGE_CONTENT intents. Local feedback and
# outbound durable delivery remain available when this is 0.
# DISCORD_INBOUND_ENABLED=0

# Required for production startup: exactly 32 random bytes encoded as canonical base64. This is the
# HMAC key for the append-only security audit chain; keep it outside the database and backups.
# Generate with: openssl rand -base64 32
# AUDIT_LEDGER_HMAC_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Optional Discord artifact preview thumbnails. Off by default: leave the URL unset unless the
# profile-gated, network-isolated renderer sidecar is running. The renderer must never be exposed
# through host ports or a tunnel because it processes untrusted, attacker-controlled HTML.
# PREVIEW_RENDERER_URL=http://artifact-preview:3000
# PREVIEW_RENDER_TIMEOUT_MS=8000
# Render/crop size. Default 1200x630 suits Discord social cards; use 1200x750 (16:10) to match the
# gallery card aspect exactly and avoid a cropped thumbnail. One render serves both consumers.
# PREVIEW_VIEWPORT=1200x750
# Maximum accepted renderer response / persisted PNG size (default 7,500,000 bytes).
# PREVIEW_MAX_PNG_BYTES=7500000

# Public base URL used to build artifact/share links (no trailing slash).
# In production set this to your real hostname; defaults to http://localhost:3480.
PUBLIC_BASE_URL=http://localhost:3480

# Portal branding. APP_BRAND is the compact mark shown beside the display name.
APP_NAME=Artifact Index
APP_BRAND=A

# Host-side port publish. Loopback prevents direct LAN ingress; for fully private tunnel-only
# ingress, remove the app's ports publish and enable the same-network cloudflared service.
HOST_BIND=127.0.0.1

# Optional Anthropic MCP Tunnel research-preview profile. These values are file
# paths only; the credential contents stay in ignored, host-managed files and
# never enter Compose environment output or the application image.
# ANTHROPIC_TUNNEL_CONFIG_FILE=./ops/anthropic-tunnel/mcp-proxy.yaml
# ANTHROPIC_TUNNEL_TOKEN_FILE=./ops/anthropic-tunnel/data/tunnel-token
# ANTHROPIC_TUNNEL_TLS_CERT_FILE=./ops/anthropic-tunnel/data/tls.crt
# ANTHROPIC_TUNNEL_TLS_KEY_FILE=./ops/anthropic-tunnel/data/tls.key

# Optional pretty-name / merge overrides. Default: the email domain IS the org.
# ORG_EMAIL_DOMAINS=example.com:acme,other.com:acme

# Who sees every org (admin)
ADMIN_EMAILS=you@example.com

# Artifact payload caps
MAX_ARTIFACT_BYTES=2097152
MAX_BUNDLE_BYTES=8388608
MAX_BUNDLE_FILES=100
# Retained revisions per artifact / max feedback length (optional; defaults shown)
# MAX_HISTORY=20
# FEEDBACK_MAX_BODY=4000
# Optional request-envelope override; computed for worst-case JSON escaping from
# MAX_BUNDLE_BYTES when omitted (8 MiB bundle default -> 50,593,792 bytes).
# MCP_JSON_LIMIT=50593792

# Origin ingress defence in depth. Keep proxy/Cloudflare limits at or below compatible values;
# the origin remains authoritative for direct traffic and proxy drift.
# INGRESS_MAX_HEADERS=64
# INGRESS_MAX_HEADER_BYTES=32768
# INGRESS_MAX_URI_BYTES=8192
# INGRESS_READ_TIMEOUT_MS=15000
# INGRESS_READ_HANDLER_TIMEOUT_MS=30000
# INGRESS_SHUTDOWN_GRACE_MS=30000
# INGRESS_MAX_CONCURRENT_REQUESTS=128
# INGRESS_MAX_CONNECTIONS=256
# INGRESS_MAX_CONCURRENT_MUTATIONS=16
# INGRESS_RENDER_QUEUE_JOBS=64
# INGRESS_RENDER_QUEUE_BYTES=16777216
# INGRESS_JSON_MAX_DEPTH=32
# INGRESS_JSON_MAX_NODES=10000
# INGRESS_JSON_MAX_MEMBERS=1000
# INGRESS_JSON_MAX_BATCH=100
# INGRESS_RATE_WINDOW_SECONDS=60
# INGRESS_READS_PER_WINDOW=120
# INGRESS_MUTATIONS_PER_WINDOW=30
# INGRESS_MCP_PER_WINDOW=60
# INGRESS_UPLOADS_PER_WINDOW=10
# INGRESS_FEEDBACK_PER_WINDOW=30
# INGRESS_ADMIN_PER_WINDOW=20
# INGRESS_VERIFIED_VIEWERS_PER_WINDOW=120
# INGRESS_SHARES_PER_WINDOW=60
# INGRESS_AUTH_FAILURES_PER_WINDOW=20
# Trust forwarded client-address headers only from these proxy CIDRs. Leave unset for direct
# deployments; spoofed forwarding headers are ignored.
# TRUSTED_PROXY_CIDRS=173.245.48.0/20,2400:cb00::/32

# Cloudflare Access JWT verification (set both in production once the Access app exists).
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-app-aud-tag
# Local/loopback development only: trust the spoofable Access email header when JWT is unset.
# TRUST_ACCESS_HEADERS=1
# Interface the app binds inside the process. Default 0.0.0.0 (a container needs it). For
# bare-metal dev with TRUST_ACCESS_HEADERS, bind loopback so the spoofable header isn't
# LAN-reachable (`npm run dev` sets this automatically). Header-trust refuses to start on a
# non-loopback bind unless HEADER_TRUST_ALLOW_INSECURE=1 (only when a proxy controls exposure).
# LISTEN_HOST=127.0.0.1
# HEADER_TRUST_ALLOW_INSECURE=1
# Production/CI strict mode: refuse startup unless both JWT settings above are configured.
# REQUIRE_ACCESS_JWT=1

# Cloudflare Access bootstrap (setup script only; not read by the running app).
# Run `node scripts/cf-access-setup.mjs` to preview, then add `--apply`. The script creates or
# updates the catch-all app but never Access policies and never writes .env. See
# docs/DEPLOY-CLOUDFLARE.md for the required Bypass/Allow policies and bootstrap order.
# CF_API_TOKEN=REPLACE_WITH_LEAST_PRIVILEGE_TOKEN
# CF_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
# CF_ACCESS_IDP_ID=REPLACE_WITH_IDP_ID
# CF_ACCESS_SESSION_DURATION=24h
# Optional defense-in-depth hostname Configuration Rule (origin no-transform is always on).
# CF_ZONE_ID=REPLACE_WITH_ZONE_ID
# Optional account-wide reusable Access login-page design. The logo must be public HTTPS;
# these settings affect every Access application in the account, not just artifact-mcp.
# CF_ACCESS_LOGIN_LOGO_URL=https://public.example.com/access-logo.png
# CF_ACCESS_LOGIN_HEADER=Sign in to continue
# CF_ACCESS_LOGIN_FOOTER=Authorized users only
# CF_ACCESS_LOGIN_BACKGROUND_COLOR=#142235
# CF_ACCESS_LOGIN_TEXT_COLOR=#FFFFFF
