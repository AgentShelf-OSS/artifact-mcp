      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Not found"
      }
    },
    {
      "name": "Missing folder concealed",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_beta}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "does-not-exist"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Not found"
      }
    },
    {
      "name": "Locked org cannot override",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "list_collections",
            "arguments": {
              "org": "beta"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Not found"
      }
    },
    {
      "name": "Collaborator can curate readable artifacts",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme2}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "create_collection",
            "arguments": {
              "name": "Collaborator folder",
              "artifact_ids": [
                "${a}",
                "${b}"
              ],
              "cover_artifact_id": "${a}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "g": "result.structuredContent.collection.id"
      }
    },
    {
      "name": "Discovery omits foreign hidden member",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme2}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "${g}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
