{
  "id": "mcp.collection-permissions",
  "fixture": "empty-v21",
  "tags": [
    "mcp",
    "collections",
    "issue-86",
    "permissions"
  ],
  "steps": [
    {
      "name": "Publish Alpha",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "title": "Alpha",
              "html": "<!doctype html><h1>Alpha</h1>"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "a": "result.structuredContent.id"
      }
    },
    {
      "name": "Publish Beta",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme2}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "title": "Beta",
              "html": "<!doctype html><h1>Beta</h1>"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "b": "result.structuredContent.id"
      }
    },
    {
      "name": "Publish Foreign",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_beta}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "title": "Foreign",
              "html": "<!doctype html><h1>Foreign</h1>"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "c": "result.structuredContent.id"
      }
    },
    {
      "name": "Create author folder",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "create_collection",
            "arguments": {
              "name": "Author folder",
              "artifact_ids": [
                "${a}"
              ],
              "cover_artifact_id": "${a}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "f": "result.structuredContent.collection.id"
      }
    },
    {
      "name": "Hide author artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "set_visibility",
            "arguments": {
              "id": "${a}",
              "hidden": true
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "afterSql": [
        "UPDATE api_keys SET role='collaborator' WHERE client_id='pub-acme2'"
      ]
    },
    {
      "name": "Collaborator cannot discover hidden count or cover",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme2}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "${f}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      }
    },
    {
      "name": "Non-creator cannot rename",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme2}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "update_collection",
            "arguments": {
              "id": "${f}",
              "name": "Forbidden rename"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Only the collection creator or an administrator can edit this collection"
      }
    },
    {
      "name": "Author cannot add other publisher artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "add_artifacts_to_collection",
            "arguments": {
              "id": "${f}",
              "artifact_ids": [
                "${b}"
              ]
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Not found"
      }
    },
    {
      "name": "Mixed foreign batch is atomic",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "add_artifacts_to_collection",
            "arguments": {
              "id": "${f}",
              "artifact_ids": [
                "${a}",
                "${c}"
              ]
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Not found"
      }
    },
    {
      "name": "Foreign folder and missing folder concealed",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_beta}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
