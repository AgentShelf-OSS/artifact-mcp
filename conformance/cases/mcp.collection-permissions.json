    {
      "name": "Administrator can edit another principal folder",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_admin}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "update_collection",
            "arguments": {
              "id": "${f}",
              "org": "acme",
              "description": "Admin curation"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
