  ],
  "postState": {
    "sql": [
      {
        "name": "memberships",
        "query": "SELECT c.name,m.artifact_id FROM collection_artifacts m JOIN collections c ON c.id=m.collection_id JOIN artifacts a ON a.id=m.artifact_id ORDER BY c.name,a.title"
      },
      {
        "name": "metadata",
        "query": "SELECT id,title,revision,hidden,org FROM artifacts ORDER BY title"
      },
      {
        "name": "principal_kinds",
        "query": "SELECT name,created_by_kind,created_by FROM collections ORDER BY name"
      }
    ]
  }
}
