      "afterSql": [
        "UPDATE api_keys SET role='reader' WHERE client_id='pub-acme2'"
      ]
    },
    {
      "name": "Reader cannot mutate its earlier folder",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme2}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "create_collection",
            "arguments": {
              "name": "Reader forbidden"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
