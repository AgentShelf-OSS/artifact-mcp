        "json": { "jsonrpc": "2.0", "id": 9, "method": "tools/call", "params": { "name": "set_visibility", "arguments": { "id": "missing123456", "hidden": true } } }
      },
      "expect": { "status": 200, "body": { "mode": "exact-json-text" } }
    }
  ]
