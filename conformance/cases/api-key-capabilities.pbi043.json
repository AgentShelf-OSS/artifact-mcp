{
  "id": "api-key-capabilities.pbi043",
  "tags": ["publisher", "tenant", "roles", "PBI-043", "CONF-ACCESS", "CONF-MCP"],
  "fixture": "empty-v21",
  "note": "Role matrix: reader has organization-wide read only; author retains own-only read/write/delete; collaborator has organization-wide read/write but owner-only delete. Cross-organization artifacts stay concealed for every role.",
  "steps": [
    {
      "name": "reader key publishes its own fixture before being assigned reader",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_acme2}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 1, "method": "tools/call",
          "params": { "name": "publish_artifact", "arguments": { "html": "<p>seed</p>", "title": "Reader own" } }
        }
      },
      "capture": { "reader_own_id": "result.structuredContent.id" },
      "afterSql": ["UPDATE api_keys SET role = 'reader' WHERE client_id = '${client_acme2}'"],
      "expect": { "status": 200, "mcpSuccess": true },
      "assertSymbols": [{ "symbol": "reader_own_id", "length": 12, "alphabet": "abcdefghijklmnopqrstuvwxyz0123456789" }]
    },
    {
      "name": "author key publishes its own fixture",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_acme}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 2, "method": "tools/call",
          "params": { "name": "publish_artifact", "arguments": { "html": "<p>seed</p>", "title": "Author own" } }
        }
      },
      "capture": { "author_own_id": "result.structuredContent.id" },
      "expect": { "status": 200, "mcpSuccess": true }
    },
    {
      "name": "author key publishes shared same-org fixture",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_acme}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 3, "method": "tools/call",
          "params": { "name": "publish_artifact", "arguments": { "html": "<p>seed</p>", "title": "Shared" } }
        }
      },
      "capture": { "shared_id": "result.structuredContent.id" },
      "expect": { "status": 200, "mcpSuccess": true }
    },
    {
      "name": "admin creates collaborator key through settings route",
      "request": {
        "method": "POST",
        "path": "/settings/keys",
        "headers": { "cf-access-authenticated-user-email": "${admin_email}", "content-type": "application/json" },
        "json": {
          "clientId": "conf-collaborator",
          "org": "acme",
          "label": "Conformance collaborator",
          "role": "collaborator"
        }
      },
      "capture": { "collaborator_secret": "secret" },
      "expect": { "status": 200 },
      "assertSymbols": [{ "symbol": "collaborator_secret", "length": 48, "alphabet": "0123456789abcdef" }]
    },
    {
      "name": "collaborator publishes its own fixture",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${collaborator_secret}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 5, "method": "tools/call",
          "params": { "name": "publish_artifact", "arguments": { "html": "<p>seed</p>", "title": "Collaborator own" } }
        }
      },
      "capture": { "collaborator_own_id": "result.structuredContent.id" },
      "expect": { "status": 200, "mcpSuccess": true }
    },
    {
      "name": "collaborator publishes author's same-org fixture",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${collaborator_secret}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 6, "method": "tools/call",
          "params": { "name": "publish_artifact", "arguments": { "html": "<p>seed</p>", "title": "Author same org" } }
        }
      },
      "capture": { "author_same_id": "result.structuredContent.id" },
      "expect": { "status": 200, "mcpSuccess": true }
    },
    {
      "name": "beta author publishes cross-org fixture",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_beta}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 7, "method": "tools/call",
          "params": { "name": "publish_artifact", "arguments": { "html": "<p>seed</p>", "title": "Cross org" } }
        }
      },
      "capture": { "cross_id": "result.structuredContent.id" },
      "expect": { "status": 200, "mcpSuccess": true }
    }
  ],
  "roleMatrix": [
    {
      "role": "reader",
      "key": "${key_acme2}",
      "targets": [
        {
          "scope": "own",
          "id": "${reader_own_id}",
          "outcomes": {
            "read": "ok",
            "write": "Permission denied: this API key cannot modify this artifact",
            "delete": "Permission denied: this API key cannot delete this artifact"
          }
        },
        {
          "scope": "same-org",
          "id": "${shared_id}",
          "outcomes": {
            "read": "ok",
            "write": "Permission denied: this API key cannot modify this artifact",
            "delete": "Permission denied: this API key cannot delete this artifact"
          }
        },
        {
          "scope": "cross-org",
          "id": "${cross_id}",
          "outcomes": {
            "read": "Unknown artifact: ${cross_id}",
            "write": "Unknown artifact: ${cross_id}",
            "delete": "Unknown artifact: ${cross_id}"
          }
        }
      ]
    },
    {
      "role": "author",
      "key": "${key_acme}",
      "targets": [
        {
          "scope": "own",
          "id": "${author_own_id}",
          "outcomes": { "read": "ok", "write": "ok", "delete": "ok" }
        },
        {
          "scope": "same-org",
          "id": "${author_same_id}",
          "outcomes": {
            "read": "Permission denied: this API key cannot read this artifact",
            "write": "Permission denied: this API key cannot modify this artifact",
            "delete": "Permission denied: this API key cannot delete this artifact"
          }
        },
        {
          "scope": "cross-org",
          "id": "${cross_id}",
          "outcomes": {
            "read": "Unknown artifact: ${cross_id}",
            "write": "Unknown artifact: ${cross_id}",
            "delete": "Unknown artifact: ${cross_id}"
          }
        }
      ]
    },
    {
      "role": "collaborator",
      "key": "${collaborator_secret}",
      "targets": [
        {
          "scope": "own",
          "id": "${collaborator_own_id}",
          "outcomes": { "read": "ok", "write": "ok", "delete": "ok" }
        },
        {
          "scope": "same-org",
          "id": "${shared_id}",
          "outcomes": {
            "read": "ok",
            "write": "ok",
            "delete": "Permission denied: this API key cannot delete this artifact"
          }
        },
        {
          "scope": "cross-org",
          "id": "${cross_id}",
          "outcomes": {
            "read": "Unknown artifact: ${cross_id}",
            "write": "Unknown artifact: ${cross_id}",
            "delete": "Unknown artifact: ${cross_id}"
          }
        }
      ]
    }
  ],
  "postState": {
    "sql": [
      {
        "name": "roles",
        "query": "SELECT client_id, role FROM api_keys WHERE client_id IN ('pub-acme2', 'pub-acme', 'conf-collaborator') ORDER BY client_id",
        "volatileFields": []
      },
      {
        "name": "matrix_effects",
        "query": "SELECT (SELECT COUNT(*) FROM artifacts WHERE id = '${reader_own_id}') AS reader_own, (SELECT COUNT(*) FROM artifacts WHERE id = '${author_own_id}') AS author_own, (SELECT COUNT(*) FROM artifacts WHERE id = '${collaborator_own_id}') AS collaborator_own, (SELECT revision FROM artifacts WHERE id = '${shared_id}') AS shared_revision, (SELECT client_id FROM artifact_revisions WHERE artifact_id = '${shared_id}' AND revision = 2) AS shared_actor",
        "volatileFields": []
      }
    ]
  }
}
