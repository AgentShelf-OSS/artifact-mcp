{
  "id": "publisher.ownership-clientid-and-org",
  "tags": ["publisher", "tenant", "invariant-1"],
  "fixture": "empty-v21",
  "note": "Author ownership requires BOTH client_id AND the artifact's CURRENT org. A sibling author key in the same org receives an explicit capability refusal, while a nonexistent or cross-organization artifact remains concealed. Control does not follow an artifact after an admin re-tenants it.",
  "steps": [
    {
      "name": "pub-acme publishes an artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_acme}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 1, "method": "tools/call",
          "params": { "name": "publish_artifact", "arguments": { "html": "<h1>owned by pub-acme</h1>", "title": "Owned" } }
        }
      },
      "capture": { "artifact_id_1": "result.structuredContent.id" },
      "expect": { "status": 200, "body": { "mode": "exact-json-text" } }
    },
    {
      "name": "a sibling author key in the same org receives an explicit capability refusal",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_acme2}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 9, "method": "tools/call",
          "params": { "name": "update_artifact", "arguments": { "id": "${artifact_id_1}", "title": "Hijacked" } }
        }
      },
      "expect": {
        "status": 200,
        "mcpError": "Permission denied: this API key cannot modify this artifact",
        "body": { "mode": "exact-json-text" }
      }
    },
    {
      "name": "a nonexistent id remains concealed",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_acme2}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 9, "method": "tools/call",
          "params": { "name": "update_artifact", "arguments": { "id": "zzzzzzzzzzzz", "title": "Hijacked" } }
        }
      },
      "expect": {
        "status": 200,
        "mcpError": "Unknown artifact: zzzzzzzzzzzz",
        "body": { "mode": "exact-json-text" }
      }
    },
    {
      "name": "an admin re-tenants the artifact into beta",
      "request": {
        "method": "POST",
        "path": "/${artifact_id_1}/move",
        "headers": { "cf-access-authenticated-user-email": "${admin_email}", "content-type": "application/json" },
        "json": { "org": "beta" }
      },
      "expect": { "status": 200, "body": { "mode": "canonical-json" } }
    },
    {
      "name": "the ORIGINAL publisher (client_id still matches) can no longer update it — org half of ownership",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": { "authorization": "Bearer ${key_acme}", "content-type": "application/json" },
        "json": {
          "jsonrpc": "2.0", "id": 9, "method": "tools/call",
          "params": { "name": "update_artifact", "arguments": { "id": "${artifact_id_1}", "title": "Hijacked" } }
        }
      },
      "expect": {
        "status": 200,
        "mcpError": "Unknown artifact: ${artifact_id_1}",
        "body": { "mode": "exact-json-text" }
      }
    }
  ],
  "postState": {
    "sql": [
      {
        "name": "artifact_after_move",
        "query": "SELECT id, org, client_id, title, revision FROM artifacts",
        "volatileFields": []
      }
    ]
  }
}
