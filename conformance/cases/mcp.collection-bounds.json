{
  "id": "mcp.collection-bounds",
  "fixture": "empty-v21",
  "tags": [
    "mcp",
    "collections",
    "issue-86",
    "pagination"
  ],
  "steps": [
    {
      "name": "Create page target",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "create_collection",
            "arguments": {
              "name": "Large folder"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "f": "result.structuredContent.collection.id"
      },
      "afterSql": [
        "WITH RECURSIVE n(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM n WHERE i<1001) INSERT INTO artifacts(id,client_id,org,title) SELECT printf('bound%04d',i),'pub-acme','acme',printf('Reference %04d',i) FROM n",
        "INSERT INTO collection_artifacts(collection_id,artifact_id,org) SELECT '${f}',id,'acme' FROM artifacts WHERE id LIKE 'bound%' AND id<>'bound1001'"
      ]
    },
    {
      "name": "Create full Unicode name",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "create_collection",
            "arguments": {
              "name": "界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "g": "result.structuredContent.collection.id"
      }
    },
    {
      "name": "First 100 of 1000 members",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "${f}",
              "limit": 100
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "members_cursor": "result.structuredContent.next_cursor"
      }
    },
    {
      "name": "Next 100 members beyond first page",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "${f}",
              "limit": 100,
              "cursor": "${members_cursor}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "members_cursor_2": "result.structuredContent.next_cursor"
      }
    },
    {
      "name": "Member cursor cannot change page size",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "${f}",
              "limit": 25,
              "cursor": "${members_cursor}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Invalid collection cursor"
      }
    },
    {
      "name": "Member cursor cannot change folder",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "${g}",
              "limit": 100,
              "cursor": "${members_cursor}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Invalid collection cursor"
      }
    },
    {
      "name": "Member cursor cannot change principal",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme2}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "get_collection",
            "arguments": {
              "id": "${f}",
              "limit": 100,
              "cursor": "${members_cursor}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "Invalid collection cursor"
      }
    },
    {
      "name": "Folder full fails without writing",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "add_artifacts_to_collection",
            "arguments": {
              "id": "${f}",
              "artifact_ids": [
                "bound1001"
              ]
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "collection member limit reached"
      }
    },
    {
      "name": "Existing member retry stays below cap",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "add_artifacts_to_collection",
            "arguments": {
              "id": "${f}",
              "artifact_ids": [
                "bound0001",
                "bound0001"
              ]
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      }
    },
    {
      "name": "Duplicate name fails",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "create_collection",
            "arguments": {
              "name": "Large folder"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "A collection with that name already exists"
      }
    },
    {
      "name": "First folder page",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "list_collections",
            "arguments": {
              "limit": 1
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "capture": {
        "folders_cursor": "result.structuredContent.next_cursor"
      }
    },
    {
      "name": "Continue folders",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "list_collections",
            "arguments": {
              "limit": 1,
              "cursor": "${folders_cursor}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpSuccess": true
      },
      "afterSql": [
        "WITH RECURSIVE n(i) AS (VALUES(1) UNION ALL SELECT i+1 FROM n WHERE i<198) INSERT INTO collections(id,org,name,name_key,created_by,created_by_kind) SELECT printf('cap%03d',i),'acme',printf('Capacity %03d',i),printf('capacity %03d',i),'pub-acme','api_key' FROM n"
      ]
    },
    {
      "name": "Folder count cap enforced",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "create_collection",
            "arguments": {
              "name": "One too many"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "organization collection limit reached"
      }
    },
    {
      "name": "Admin must select org",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_admin}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "list_collections",
            "arguments": {}
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "org is required"
      }
    },
    {
      "name": "Admin cannot use virtual all",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_admin}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "list_collections",
            "arguments": {
              "org": "all"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": []
        },
        "mcpError": "org is required"
      }
    }
  ],
  "postState": {
    "sql": [
      {
        "name": "counts",
        "query": "SELECT (SELECT COUNT(*) FROM collections WHERE org='acme') AS folders,(SELECT COUNT(*) FROM collection_artifacts WHERE collection_id='${f}') AS members"
      },
      {
        "name": "failed_target_absent",
        "query": "SELECT COUNT(*) AS count FROM collection_artifacts WHERE artifact_id='bound1001'"
      }
    ]
  }
}
