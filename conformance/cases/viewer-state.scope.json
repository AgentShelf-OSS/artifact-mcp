    {
      "name": "reject malformed scope scope=",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 400,
