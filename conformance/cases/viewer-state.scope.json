{
  "id": "viewer-state.scope",
  "fixture": "empty-v21",
  "tags": [
    "viewer-state",
    "issue-40"
  ],
  "env": {
    "INGRESS_STATE_PER_WINDOW": "200"
  },
  "steps": [
    {
      "name": "publish_artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "html": "<!doctype html><html><body><h1>Viewer state</h1></body></html>",
              "title": "Viewer state"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      },
      "capture": {
        "artifact_id_1": "result.structuredContent.id"
      }
    },
    {
      "name": "omitted scope creates an org key",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/note",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "shared",
          "if_revision": 0
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "explicit org scope reads the default value",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=org",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "another org viewer sees the default value",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Alice creates her private note",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "Alice diary",
          "if_revision": 0
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Alice reads private state without writer email",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Charlie cannot read Alice private note",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "an admin cannot read Alice private note",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Charlie private list is empty",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Charlie creates his own note at revision one",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "Charlie diary",
          "if_revision": 0
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Charlie reads his own note",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Alice private note remains intact",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "email case selects the same owner",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "ALICE@ACME.TEST"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "admin creates an independent private note",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "Admin diary",
          "if_revision": 0
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "admin reads only own private list",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}"
        }
      },
      "expect": {
        "status": 200,
