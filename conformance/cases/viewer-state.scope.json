            "updated_at"
          ]
        }
      }
    },
    {
      "name": "viewer cannot select another owner with query parameter",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer&viewer=charlie%40acme.test",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "private revision conflict returns only current value",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "stale",
          "if_revision": 0
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Alice lists her own private keys",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "org list remains independent",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Charlie deletes only his private note",
      "request": {
        "method": "DELETE",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        }
      },
      "expect": {
        "status": 204,
        "body": {
          "mode": "exact-bytes",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Charlie private note was deleted",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "Alice private note survives Charlie delete",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=viewer",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "shared note survives private delete",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note",
        "headers": {
          "cf-access-authenticated-user-email": "charlie@acme.test"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "invalid scope rejected for GET list",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state?scope=team",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "invalid scope rejected for GET",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/note?scope=team",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "invalid scope rejected for PUT",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/note?scope=team",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "no"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "invalid scope rejected for DELETE",
      "request": {
        "method": "DELETE",
        "path": "/${artifact_id_1}/state/note?scope=team",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        }
      },
      "expect": {
