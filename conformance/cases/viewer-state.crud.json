{
  "id": "viewer-state.crud",
  "steps": [
    {
      "name": "publish_artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "html": "<!doctype html><html><body><h1>Viewer state</h1></body></html>",
              "title": "Viewer state"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      },
      "capture": {
        "artifact_id_1": "result.structuredContent.id"
      }
    },
    {
      "name": "new artifact has no state keys",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "create nested JSON with missing-key revision zero",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": {
            "chapter": 1,
            "notes": [
              "first"
            ]
          },
          "if_revision": 0
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "round trip contains writer attribution for the shell",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "list only key metadata",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "compare and swap increments revision",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": {
            "chapter": 2,
            "notes": [
              "first",
              "second"
            ]
          },
          "if_revision": 1
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "stale revision returns canonical value",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "stale",
          "if_revision": 1
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "conflict did not mutate the row",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "admin can read another organization's state",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "admin writes any JSON type",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": null,
          "if_revision": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "update_artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "tools/call",
          "params": {
            "name": "update_artifact",
            "arguments": {
              "id": "${artifact_id_1}",
              "html": "<h1>Updated artifact</h1>",
              "expected_revision": 1
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      }
    },
    {
      "name": "state survives artifact revision updates",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "delete a key",
      "request": {
        "method": "DELETE",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        }
      },
      "expect": {
        "status": 204,
        "body": {
          "mode": "exact-bytes"
        }
      }
    },
    {
      "name": "delete is idempotent",
      "request": {
        "method": "DELETE",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        }
      },
      "expect": {
        "status": 204,
        "body": {
          "mode": "exact-bytes"
        }
      }
    },
    {
      "name": "deleted key is absent",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/reading.notes",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "new key after deletion starts at one",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/cascade",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": true
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "delete_artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "tools/call",
          "params": {
            "name": "delete_artifact",
            "arguments": {
              "id": "${artifact_id_1}"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      }
    }
  ],
  "postState": {
    "sql": [
      {
        "name": "state_cascades_with_artifact",
        "query": "SELECT * FROM artifact_state",
        "volatileFields": [
          "updated_at"
        ]
      }
    ]
  },
  "tags": [
    "viewer-state",
    "issue-38"
  ],
  "fixture": "empty-v21"
}
