      "request": {
        "method": "GET",
        "path": "/settings/data-sources/operator-feed/impact",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "definition",
            "last_success_at",
            "last_query_at",
            "last_event_at",
            "elapsed_ms"
          ]
        }
      }
    },
    {
