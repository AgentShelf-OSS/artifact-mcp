      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json"
        }
      }
    },
    {
      "name": "HTTP tests reject undeclared parameters before contacting upstream",
      "request": {
        "method": "POST",
        "path": "/settings/data-sources/operator-http/test",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "operation": "status",
          "params": {
            "unknown": "x"
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json"
        }
      }
    },
    {
      "name": "push tests reject a non-string operation",
      "request": {
        "method": "POST",
        "path": "/settings/data-sources/managed-push/test",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "operation": 123
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json"
        }
      }
    },
    {
      "name": "publish artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_admin}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "org": "connections-test",
              "html": "<main>Connection lifecycle</main>",
              "title": "Connection lifecycle"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "definition",
            "last_success_at",
            "last_query_at",
            "last_event_at",
            "elapsed_ms"
          ]
        }
      },
      "capture": {
        "artifact_id_1": "result.structuredContent.id"
      }
    },
    {
      "name": "admin assigns artifact grants",
      "request": {
        "method": "PUT",
        "path": "/settings/data-bindings/${artifact_id_1}",
