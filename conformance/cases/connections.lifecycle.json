{
  "id": "connections.lifecycle",
  "tags": [
    "connections",
    "admin",
    "live-data"
  ],
  "fixture": "empty-v21",
  "env": {
    "INGRESS_MUTATIONS_PER_WINDOW": "1000",
    "INGRESS_ADMIN_PER_WINDOW": "1000"
  },
  "note": "Admin source lifecycle, optimistic versions, operator protection, binding impact and cleanup. Definition serialization defaults are checked by runtime validator tests; timestamps and read-only test timing are volatile.",
  "dataSources": {
    "sources": [
      {
        "id": "operator-feed",
        "org": "connections-test",
        "kind": "push",
        "operations": {
          "latest": {}
        },
        "subscriptions": {
          "events": {
            "transport": "push"
          }
        }
      },
      {
        "id": "operator-http",
        "org": "connections-test",
        "kind": "http",
        "base_url": "https://example.invalid",
        "operations": {
          "status": {
            "path": "/status"
          }
        },
        "subscriptions": {}
      }
    ]
  },
  "steps": [
    {
      "name": "create test organization",
      "request": {
        "method": "POST",
        "path": "/settings/orgs",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "name": "connections-test"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "non-admin cannot inspect source definitions",
      "request": {
        "method": "GET",
        "path": "/settings/data-sources",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 403
      }
    },
    {
      "name": "unsafe requests require mutation signal",
      "request": {
        "method": "POST",
        "path": "/settings/data-sources",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}"
        },
        "json": {
          "definition": {
            "id": "managed-push",
            "org": "connections-test",
            "kind": "push",
            "operations": {
              "latest": {
                "key": "summary"
              }
            },
            "subscriptions": {
              "updates": {
                "transport": "push"
              }
            }
          },
          "enabled": true
        }
      },
      "expect": {
        "status": 403
      }
    },
    {
      "name": "create managed source",
      "request": {
        "method": "POST",
        "path": "/settings/data-sources",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "definition": {
            "id": "managed-push",
            "org": "connections-test",
            "kind": "push",
            "operations": {
              "latest": {
                "key": "summary"
              }
            },
            "subscriptions": {
              "updates": {
                "transport": "push"
              }
            }
          },
          "enabled": true
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "definition",
            "last_success_at",
            "last_query_at",
            "last_event_at",
            "elapsed_ms"
          ]
        }
      }
    },
    {
      "name": "unknown artifacts have no editable bindings",
      "request": {
        "method": "GET",
        "path": "/settings/data-bindings/does-not-exist",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "mode": "canonical-json"
        }
      }
    },
    {
      "name": "unbound sources cannot move to an unknown organization",
      "request": {
        "method": "PATCH",
        "path": "/settings/data-sources/managed-push",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "definition": {
            "id": "managed-push",
            "org": "does-not-exist",
            "kind": "push",
            "operations": {
              "latest": {
                "key": "summary"
              }
            },
            "subscriptions": {
              "updates": {
                "transport": "push"
              }
            }
          },
          "enabled": true,
          "expected_version": 1
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json"
        }
      }
    },
    {
      "name": "source IDs cannot collide",
      "request": {
        "method": "POST",
        "path": "/settings/data-sources",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "definition": {
            "id": "managed-push",
            "org": "connections-test",
            "kind": "push",
            "operations": {
              "latest": {
                "key": "summary"
              }
            },
            "subscriptions": {
              "updates": {
                "transport": "push"
              }
            }
          },
          "enabled": true
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "definition",
            "last_success_at",
            "last_query_at",
            "last_event_at",
            "elapsed_ms"
          ]
        }
      }
    },
    {
      "name": "operator source is read only",
      "request": {
        "method": "POST",
        "path": "/settings/data-sources/operator-feed/disable",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "expected_version": 1
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "definition",
            "last_success_at",
            "last_query_at",
            "last_event_at",
            "elapsed_ms"
          ]
        }
      }
    },
    {
      "name": "operator source cannot be deleted",
      "request": {
        "method": "DELETE",
        "path": "/settings/data-sources/operator-feed",
        "headers": {
          "cf-access-authenticated-user-email": "${admin_email}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "expected_version": 1
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "definition",
            "last_success_at",
            "last_query_at",
