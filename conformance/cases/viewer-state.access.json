{
  "id": "viewer-state.access",
  "steps": [
    {
      "name": "publish_artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "html": "<!doctype html><html><body><h1>Viewer state</h1></body></html>",
              "title": "Viewer state"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      },
      "capture": {
        "artifact_id_1": "result.structuredContent.id"
      }
    },
    {
      "name": "seed org-private state",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/private",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": "org only"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "cross-org GET conceals foreign artifact",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_beta}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "mode": "exact-bytes"
        },
        "headers": {
          "mode": "exact-header"
        }
      }
    },
    {
      "name": "cross-org GET conceals absent artifact",
      "request": {
        "method": "GET",
        "path": "/zzzzzzzzzzzz/state",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_beta}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
