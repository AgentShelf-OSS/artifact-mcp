        },
        "json": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "tools/call",
          "params": {
            "name": "create_share",
            "arguments": {
              "id": "${artifact_id_1}",
              "expires": "never"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      },
      "capture": {
        "share_token_1": "result.structuredContent.token"
      }
    },
    {
      "name": "share token does not authorize org state reads",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state/private",
        "headers": {
          "authorization": "Bearer ${share_token_1}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "mode": "exact-bytes"
        }
      }
    },
    {
      "name": "share token does not authorize org state writes",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/private",
        "headers": {
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin",
          "authorization": "Bearer ${share_token_1}"
        },
        "json": {
          "value": "denied"
        }
      },
      "expect": {
        "status": 404,
        "body": {
