{
  "id": "viewer-state.validation",
  "steps": [
    {
      "name": "publish_artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "html": "<!doctype html><html><body><h1>Viewer state</h1></body></html>",
              "title": "Viewer state"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      },
      "capture": {
        "artifact_id_1": "result.structuredContent.id"
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/bad%20key",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 1
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject trailing newline in key",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/ends%0A",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 1
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 1
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/valid",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {}
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/valid",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 1,
          "if_revision": -1
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/valid",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 1,
          "if_revision": 1.5
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/valid",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 1,
          "if_revision": "0"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/valid",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": null
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/valid",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": []
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "reject malformed key or envelope",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/valid",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 1,
          "extra": 2
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "serialized value exactly 256 KiB is accepted",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/limit",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "genBody": {
          "kind": "state-value",
          "length": 262142
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "serialized value over 256 KiB is rejected",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/too-big",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "genBody": {
          "kind": "state-value",
          "length": 262143
        }
      },
      "expect": {
        "status": 413,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "value limit counts UTF-8 bytes",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/utf8",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "genBody": {
          "kind": "state-value",
          "character": "\u00e9",
          "length": 131072
        }
      },
      "expect": {
        "status": 413,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    },
    {
      "name": "only the accepted key exists",
      "request": {
        "method": "GET",
        "path": "/${artifact_id_1}/state",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
      }
    }
  ],
  "postState": {
    "sql": [
      {
        "name": "serialized_byte_limit",
        "query": "SELECT key, length(CAST(value AS BLOB)) AS bytes, revision FROM artifact_state ORDER BY key"
      }
    ]
  },
  "tags": [
    "viewer-state",
    "issue-38"
  ],
  "fixture": "empty-v21"
}
