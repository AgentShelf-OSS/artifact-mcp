{
  "id": "viewer-state.key-cap",
  "env": { "INGRESS_STATE_PER_WINDOW": "200" },
  "steps": [
    {
      "name": "publish_artifact",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "authorization": "Bearer ${key_acme}"
        },
        "json": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "publish_artifact",
            "arguments": {
              "html": "<!doctype html><html><body><h1>Viewer state</h1></body></html>",
              "title": "Viewer state"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "mcpSuccess": true,
        "body": {
          "mode": "exact-json-text"
        }
      },
      "capture": {
        "artifact_id_1": "result.structuredContent.id"
      }
    },
    {
      "name": "create key 1 of 64",
      "request": {
        "method": "PUT",
        "path": "/${artifact_id_1}/state/key-00",
        "headers": {
          "cf-access-authenticated-user-email": "${viewer_acme}",
          "x-artifact-mutation": "1",
          "sec-fetch-site": "same-origin"
        },
        "json": {
          "value": 0
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "canonical-json",
          "volatileFields": [
            "updated_at"
          ]
        }
